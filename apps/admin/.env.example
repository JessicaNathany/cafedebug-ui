###
# apps/admin host-run local environment contract
# Copy to apps/admin/.env.local before running:
#   cp apps/admin/.env.example apps/admin/.env.local
###

# Admin URL when running next dev on host
ADMIN_PUBLIC_URL=http://localhost:3001

# Backend API URL consumed by the admin app
ADMIN_API_BASE_URL=http://localhost:8080

# Cookie/session configuration for local development
ADMIN_COOKIE_DOMAIN=localhost
ADMIN_COOKIE_SAMESITE=Lax
ADMIN_COOKIE_SECURE=false

# Optional: force TLS bypass only when your local backend uses a self-signed/dev certificate.
# Keep commented by default.
# NODE_TLS_REJECT_UNAUTHORIZED=0
